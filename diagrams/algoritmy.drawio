<mxfile host="drawio" type="device"><diagram id="p0" name="Алгоритм 1. Оценка стоимости"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Начало" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="45.0" y="17.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c2" value="Ввод: оцениваемая квартира, объявления, текущая дата" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;shape=parallelogram;perimeter=parallelogramPerimeter;size=0.1;spacingLeft=22;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="45.0" y="107.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c3" value="аналоги ← пустой список" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="45.0" y="197.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c4" value="Для каждого объявления a" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;shape=loopLimit;" vertex="1" parent="1"><mxGeometry x="45.0" y="287.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c5" value="Район и комнаты совпадают, |ΔS|/S ≤ 0,25, возраст ≤ 180 дн.?" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rhombus;spacingLeft=48;spacingRight=48;" vertex="1" parent="1"><mxGeometry x="15.0" y="363.0" width="310" height="84" as="geometry"/></mxCell><mxCell id="c6" value="Добавить a в аналоги" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="45.0" y="467.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Конец цикла по a" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;shape=loopLimit;flipV=1;" vertex="1" parent="1"><mxGeometry x="45.0" y="557.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c8" value="Аналогов меньше 3?" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rhombus;spacingLeft=48;spacingRight=48;" vertex="1" parent="1"><mxGeometry x="15.0" y="636.0" width="310" height="78" as="geometry"/></mxCell><mxCell id="c9" value="Для каждого аналога: u ← цена / S × 0,97 × kэт(объект) / kэт(аналог)" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="45.0" y="737.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c10" value="m ← медиана(u); оставить аналоги с |u − m| / m ≤ 0,25" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="45.0" y="827.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c11" value="Осталось меньше 3?" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rhombus;spacingLeft=48;spacingRight=48;" vertex="1" parent="1"><mxGeometry x="15.0" y="906.0" width="310" height="78" as="geometry"/></mxCell><mxCell id="c12" value="w ← 1 / (1 + d); u* ← Σ(w·u) / Σw; цена ← u* × S, округлить до 10 000" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rounded=0;" vertex="1" parent="1"><mxGeometry x="45.0" y="1007.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Вывод: цена, диапазон цен, использованные аналоги" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;shape=parallelogram;perimeter=parallelogramPerimeter;size=0.1;spacingLeft=22;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="45.0" y="1097.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c14" value="Конец" style="fontFamily=Times New Roman;whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="45.0" y="1187.0" width="250" height="56" as="geometry"/></mxCell><mxCell id="c15" value="Вывод: недостаточно а